// Quotly — esquema de datos (Fases 1-7 del spec). Corre en Postgres
// (Supabase) desde el cambio a producción; antes corría en SQLite local.
//
// Nota de portabilidad: los campos "tipo enum" (categoria, tipoCliente,
// modalidad, estado, tier) se guardan como String validado en la capa de
// aplicación (zod), y las listas (modalidades disponibles) como JSON
// serializado, en vez de usar enums/arrays nativos de Postgres — así el
// esquema se mantuvo idéntico durante la migración de SQLite a Postgres,
// sin tener que tocar ningún modelo.
//
// Las URLs de conexión (DATABASE_URL pooled + DIRECT_URL directa) viven en
// prisma.config.ts, no aquí — así funciona la configuración en Prisma 7.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Parámetros generales del sistema (Fase 1). Fila única (id fijo = 1).
model SystemConfig {
  id Int @id @default(1)

  umaDiaria    Float
  umaMensual   Float
  topeSbcUmas  Float // en múltiplos de UMA, ej. 25

  /// Salario mínimo general vigente (Campeche, zona general). Vive en la
  /// sección fiscal (candado de contraseña) — es la base de las bandas 1-2
  /// de la tabla CEAV y de la alerta de sueldo por debajo del mínimo.
  salarioMinimoDiario  Float
  salarioMinimoMensual Float

  primaRiesgoPct Float // editable — cambia según clasificación IMSS, dato de negocio (sin candado)

  imssEnfMatCuotaFijaPct Float // % de 1 UMA mensual
  imssEnfMatCuotaAdicPct Float // % del excedente sobre 3 UMA
  imssEnfMatDineroPct    Float // % del SBC
  imssGastosMedPensPct   Float // % del SBC
  imssInvalidezVidaPct   Float // % del SBC
  imssGuarderiasPct      Float // % del SBC
  imssRetiroPct          Float // % del SBC
  // Cesantía y Vejez (CEAV) ya NO es tasa fija — ver modelo CeavBanda.
  // Reforma LSS/LSAR (DOF 16-dic-2020), Art. 168 fracción II: la cuota
  // patronal depende del SBC del trabajador en múltiplos de UMA/SM.

  infonavitPct Float // % del SBC

  isnPct                Float // % de la nómina
  impuestoAdicionalPct  Float // % del ISN

  diasAguinaldo       Int
  diasVacaciones      Int
  primaVacacionalPct  Float

  ivaPct         Float
  retencionIsrPct Float // Art. 113-J RESICO, solo Persona Moral

  horasPorDia    Int
  diasPorSemana  Int

  margenUtilidadDefaultPct Float // placeholder inicial, editable en /configuracion

  /// Datos del "Prestador de servicio" — Fase 11 (exportación). Solo se
  /// usan para el membrete de los documentos exportados (Word/PDF) de
  /// cotización, no participan en ningún cálculo. Sembrados con un nombre
  /// placeholder y el resto vacío — el usuario los completa una vez en
  /// /configuracion, sin candado (no son datos fiscales sensibles).
  prestadorNombre     String  @default("Multiservicios Yerves")
  prestadorRfc        String?
  prestadorDireccion  String?
  prestadorTelefono   String?
  prestadorEmail      String?

  updatedAt DateTime @updatedAt
}

/// Tabla de bandas de Cesantía y Vejez (CEAV) — Addendum v4, punto 1.
/// La cuota patronal depende de en qué banda cae el SBC mensual del
/// trabajador. `unidadLimite` indica contra qué se compara
/// `limiteSuperior`:
///   - "SALARIO_MINIMO": limiteSuperior × salarioMinimoMensual (bandas 1-2)
///   - "UMA": limiteSuperior × umaMensual (bandas 3-8)
/// `limiteSuperior` null = sin tope (última banda, "4.01 UMA en adelante").
/// Las bandas se evalúan en orden (`orden` 1→8) y se toma la primera cuyo
/// tope no se exceda. Esto NO es un rango estrictamente monótono en pesos:
/// el salario mínimo ha crecido mucho más rápido que la UMA desde 2019, así
/// que en 2026 "1.50×SM" (banda 2, ~$14,374) es mayor en pesos que
/// "2.00×UMA" (banda 3, ~$7,132) — las bandas 3-5 quedan prácticamente
/// inalcanzables para sueldos típicos. Es un artefacto real de la reforma
/// (DOF 16-dic-2020) al no haberse actualizado desde entonces la mezcla de
/// unidades SM/UMA de las bandas bajas.
model CeavBanda {
  id                 String @id @default(cuid())
  anio               Int
  orden              Int
  etiqueta           String // texto oficial de la banda, para mostrar
  unidadLimite       String // "SALARIO_MINIMO" | "UMA"
  limiteSuperior     Float? // multiplicador; null = sin límite superior
  porcentajePatronal Float

  @@unique([anio, orden])
}

/// Puesto de trabajo reutilizable entre servicios (Fase 3).
model Puesto {
  id            String   @id @default(cuid())
  nombre        String
  sueldoMensual Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  servicios Servicio[]
}

/// Servicio del catálogo (Fase 3). categoria: LIMPIEZA | SEGURIDAD |
/// MANTENIMIENTO | FUMIGACION | JARDINES | AC (validado en zod).
///
/// Addendum v4 punto 4: el costo de mano de obra ya NO depende de tener un
/// Puesto pre-guardado. `puestoId` es opcional — si es null, el sueldo vive
/// directamente en `sueldoMensualInline`/`nombrePuestoInline` (capturado en
/// el propio formulario de Servicio, con opción de guardarlo como Puesto
/// después). Exactamente uno de los dos caminos debe estar presente —
/// validado en zod (servicioSchema), no en el esquema de BD.
model Servicio {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  categoria   String

  puestoId String?
  puesto   Puesto? @relation(fields: [puestoId], references: [id], onDelete: SetNull)

  // Usado solo cuando puestoId es null — sueldo capturado directo en el
  // formulario de Servicio, sin pasar por el catálogo de Puestos.
  sueldoMensualInline Float?
  nombrePuestoInline  String?

  personalPorUnidad Int @default(1)

  // modalidades disponibles: JSON de un subconjunto de
  // ["HORA","DIA","SEMANA","MES"]
  modalidadesJson String @default("[]")

  incluyeUniforme       Boolean @default(false)
  costoUniforme         Float?
  vidaUtilUniformeMeses Int?

  incluyeMaterial       Boolean @default(false)
  costoMaterial         Float?
  vidaUtilMaterialMeses Int?

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineas LineaCotizacion[]
}

/// Cliente de una cotización (Fase 4). tipoCliente: PERSONA_MORAL |
/// PERSONA_FISICA | GOBIERNO (validado en zod).
model Cliente {
  id                String  @id @default(cuid())
  nombreRazonSocial String
  rfc               String?
  contacto          String?
  tipoCliente       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cotizaciones Cotizacion[]
}

/// Cotización (Fases 4-7, tipo agregado en Fase 9). estado: BORRADOR |
/// ENVIADA | ACEPTADA | RECHAZADA (validado en zod) — son también las 4
/// columnas del kanban de seguimiento (Fase 6). Cuando estado pasa a
/// ACEPTADA, desde su detalle se puede generar una CuentaPorCobrar
/// (Fase 7) — relación 1:1 opcional.
///
/// tipo: SERVICIO | MATERIAL (Fase 9, validado en zod) — decide cuál de
/// las dos relaciones de líneas aplica. Nunca se mezclan en un mismo
/// documento: una cotización SERVICIO solo tiene `lineas`
/// (LineaCotizacion), una MATERIAL solo `lineasMaterial`
/// (LineaCotizacionMaterial) — no hay constraint de BD para esto, se
/// garantiza en la capa de datos (createCotizacion/createCotizacionMaterial
/// nunca llenan la relación del otro tipo). Ambos tipos comparten el mismo
/// pipeline de estados, kanban, modal de confirmación y generación de
/// cuenta por cobrar — por eso viven en el mismo modelo en vez de uno
/// paralelo completo.
model Cotizacion {
  id     String @id @default(cuid())
  folio  String @unique
  tipo   String @default("SERVICIO")

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  proyecto  String?

  /// Snapshot editable por cotización. Solo aplica a tipo SERVICIO — el
  /// costo real ahí viene del motor de nómina/IMSS/INFONAVIT (Fase 2). Las
  /// cotizaciones MATERIAL no tienen ese concepto de margen: el precio de
  /// venta se captura directo por línea (ver LineaCotizacionMaterial), así
  /// que este campo queda null.
  margenUtilidadPct Float?

  subtotal     Float @default(0)
  iva          Float @default(0)
  retencionIsr Float @default(0)
  totalAPagar  Float @default(0)
  netoARecibir Float @default(0)

  estado String @default("BORRADOR")

  /// Fecha de vigencia/validez propia de esta cotización (varía por
  /// cotización, ej. 15 días desde su creación) — usada por el kanban de
  /// Fase 6 para el recordatorio de "por vencer"/"vencida".
  fechaVigencia DateTime

  /// Cotización generada solo como trámite interno del cliente (papeleo
  /// de compras sin intención real de compra) — no es un estado ni un tipo
  /// separado, solo un flag que el kanban oculta por defecto.
  esSoporte Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineas          LineaCotizacion[]
  lineasMaterial  LineaCotizacionMaterial[]
  cuentaPorCobrar CuentaPorCobrar?
}

/// Línea de servicio dentro de una cotización tipo SERVICIO. Guarda un
/// snapshot del costo real unitario calculado en el momento (las tasas de
/// Configuración cambian cada año — una cotización vieja no debe
/// recalcularse con tasas nuevas). modalidad: HORA | DIA | SEMANA | MES.
model LineaCotizacion {
  id String @id @default(cuid())

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  modalidad String
  personas  Int
  duracion  Int // número de unidades en la modalidad (ej. 20 días)

  costoRealUnitarioSnapshot Float
  costoRealTotal            Float
  precioVenta               Float

  createdAt DateTime @default(now())
}

/// Línea de material dentro de una cotización tipo MATERIAL (Fase 9).
/// `precioUnitario` se precarga desde Producto.precioVentaSugerido pero es
/// editable en la cotización; `importe` (cantidad × precioUnitario) se
/// guarda como snapshot, igual que precioVenta en LineaCotizacion — no se
/// recalcula si el precio sugerido del producto cambia después. Al aceptar
/// la cotización (confirmarAceptacionMaterial), cada línea genera una
/// salida de MovimientoInventario por "Venta a cliente".
model LineaCotizacionMaterial {
  id String @id @default(cuid())

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad       Float
  precioUnitario Float
  importe        Float

  createdAt DateTime @default(now())
}

/// Cuenta por cobrar (Fase 7) — se genera automáticamente al confirmar la
/// aceptación de una Cotización (ver confirmarAceptacionAction), pidiendo
/// la fecha de vencimiento en ese momento (no se puede derivar de la
/// cotización). `montoTotal` es un snapshot de `cotizacion.netoARecibir`
/// — lo que realmente se cobra en efectivo, no `totalAPagar` (la
/// retención ISR no la paga el cliente a ti, se la queda para enterarla
/// al SAT).
///
/// Pendiente/Parcial/Cobrada se calculan del saldo en tiempo de lectura
/// (ver lib/cuentas.ts) — pero `cancelada` SÍ se guarda explícitamente,
/// porque "cancelada" no es derivable del saldo. Solo se puede cancelar
/// una cuenta que ya tiene abonos (si no tiene ninguno, se elimina de
/// verdad en vez de cancelarse). Una cuenta cancelada conserva su
/// historial de abonos para auditoría, pero deja de contar en los KPIs de
/// "por cobrar"/"vencido" y ya no admite abonos nuevos.
model CuentaPorCobrar {
  id           String     @id @default(cuid())
  cotizacionId String     @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])

  montoTotal      Float
  fechaVencimiento DateTime
  cancelada       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  abonos AbonoPorCobrar[]
}

model AbonoPorCobrar {
  id                String          @id @default(cuid())
  cuentaPorCobrarId String
  cuentaPorCobrar   CuentaPorCobrar @relation(fields: [cuentaPorCobrarId], references: [id], onDelete: Cascade)

  fecha  DateTime
  monto  Float
  nota   String?

  createdAt DateTime @default(now())
}

/// Cuenta por pagar (Fase 7) — registro independiente (proveedor en texto
/// libre, sin catálogo propio todavía). Mismo sistema de abonos parciales
/// y estado calculado que CuentaPorCobrar.
model CuentaPorPagar {
  id        String @id @default(cuid())
  concepto  String
  proveedor String

  montoTotal       Float
  fechaVencimiento DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  abonos AbonoPorPagar[]
}

model AbonoPorPagar {
  id               String         @id @default(cuid())
  cuentaPorPagarId String
  cuentaPorPagar   CuentaPorPagar @relation(fields: [cuentaPorPagarId], references: [id], onDelete: Cascade)

  fecha DateTime
  monto Float
  nota  String?

  createdAt DateTime @default(now())
}

/// Cuenta de usuario. Por ahora solo existe el bootstrap del primer usuario
/// vía /setup — no hay pantalla de alta de usuarios adicionales.
model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session Session?
}

/// Producto del catálogo de inventario/almacén (Fase 8). Materiales que se
/// compran para reventa a clientes y materiales de uso interno del propio
/// personal (ej. insumos de limpieza) comparten el mismo almacén — no hay
/// separación en el modelo. `costoCompraReciente` NUNCA se edita
/// directamente: se actualiza solo al registrar una entrada (ver
/// lib/data/movimientosInventario.ts). `precioVentaSugerido` es para
/// cuando se cotice a un cliente (Fase 9, todavía no conectado).
model Producto {
  id           String  @id @default(cuid())
  nombre       String
  descripcion  String?
  unidadMedida String // PIEZA | LITRO | KG | CAJA | ... (validado en zod)

  costoCompraReciente Float?
  precioVentaSugerido Float?

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimientos    MovimientoInventario[]
  lineasMaterial LineaCotizacionMaterial[]
}

/// Movimiento de inventario — entrada (compra) o salida (venta a cliente o
/// uso interno) — Fase 8. El stock actual de un Producto NUNCA se guarda
/// como campo directo: siempre es la suma de sus movimientos (entradas -
/// salidas), calculada en tiempo de lectura (ver lib/inventario.ts).
///
/// tipo: ENTRADA | SALIDA. En una ENTRADA se captura proveedor (texto
/// libre, sin catálogo propio todavía) y costoUnitario. En una SALIDA se
/// captura motivoSalida (VENTA_CLIENTE | USO_INTERNO) y opcionalmente una
/// referencia en texto libre (a qué cliente/servicio corresponde — la
/// Fase 9 de cotización de materiales lo conectará formalmente).
model MovimientoInventario {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  tipo     String
  fecha    DateTime
  cantidad Float

  // Solo ENTRADA
  proveedor     String?
  costoUnitario Float?

  // Solo SALIDA
  motivoSalida String?
  referencia   String?

  createdAt DateTime @default(now())
}

/// Registro de control de Activos de la empresa (Fase 10) — vehículos,
/// equipo, herramientas, mobiliario, equipo de cómputo. Registro general
/// de la empresa, sin asignación a empleado específico (confirmado que no
/// se necesita ese nivel de detalle). Sin depreciación ni cálculos
/// financieros — solo captura y consulta, no es un módulo contable.
/// `estado` (FUNCIONAL | EN_REPARACION | DADO_DE_BAJA, validado en zod)
/// nunca borra el registro: "dado de baja" se conserva para historial,
/// solo deja de contar como activo funcional — sigue visible en el
/// listado con el filtro de estado.
model Activo {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  categoria   String // VEHICULO | EQUIPO_LIMPIEZA | HERRAMIENTA | MOBILIARIO | EQUIPO_COMPUTO | OTRO

  fechaAdquisicion DateTime
  valorAdquisicion Float

  estado String @default("FUNCIONAL")

  notas String? // ubicación / notas libres, ej. "en bodega principal"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sesión activa. `usuarioId` es único a propósito: una sola fila por
/// usuario, así que iniciar sesión en un segundo lugar reemplaza el token
/// (upsert) y el anterior deja de ser válido en su siguiente request.
/// `expiresAt` se recorre 30 min hacia adelante en cada actividad
/// (sliding expiration) para el auto-cierre por inactividad.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
